# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SMTP Configuration (Kept server-side only)
# Default recommended configuration:
SMTP_HOST="out.postassl.it"
SMTP_PORT="465"
SMTP_SECURITY="ssl" # "ssl" (port 465), "starttls" (port 587), or "none" (port 25)
SMTP_USER="noreply@smaltimento-rifiuti-roma.it"
SMTP_PASS="" # Enter in SMTP Settings UI or set here
SMTP_FROM_EMAIL="noreply@smaltimento-rifiuti-roma.it"
SMTP_FROM_NAME="ApexMail Dispatcher"
SMTP_REPLY_TO="noreply@smaltimento-rifiuti-roma.it"

# Sending safety controls
RATE_LIMIT_PER_SECOND="5"
BATCH_SIZE="10"
MAX_RETRIES="3"
DEVELOPMENT_MODE="false" # When true, logs email instead of dispatching to network
